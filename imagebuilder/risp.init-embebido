#!/bin/sh /etc/rc.common
# RISP (NAS RADIUS backend) — init script OpenWrt (procd)
# Instalar: cp risp.init /etc/init.d/risp && chmod +x /etc/init.d/risp
# Uso: /etc/init.d/risp enable && /etc/init.d/risp start
START=99
STOP=10

USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /etc/risp/risp
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # RISP no deja procesos hijos; procd lo mata
    :
}
