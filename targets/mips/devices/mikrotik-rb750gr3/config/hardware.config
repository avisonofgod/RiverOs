# RB750Gr3 hardware: red (DSA/MT7530) + UART + WDT
# Contrato: este fragmento + mips-base + mt7621-base debe pasar check-config.sh
# (la combinacion es la fuente del .config, no un "extra": faltar un simbolo
# aqui = kernel sin red aunque el device tree sea correcto)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_BRIDGE=y
CONFIG_NET_SWITCHDEV=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_TAG_MTK=y
CONFIG_NET_DSA_MT7530=y
CONFIG_NET_DSA_MT7530_MDIO=y
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MDIO_BUS=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_DEVRES=y
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_FIXED_PHY=y
CONFIG_MEDIATEK_GE_PHY=y
# mt7530 usa regmap-mmio en 6.12 (ver patches/kernel/0001-*: select REGMAP_MMIO)
CONFIG_REGMAP=y
CONFIG_REGMAP_MMIO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# WDT del MT7621 = mt7621_wdt (MEDIATEK_WATCHDOG es el mtk_wdt de MT762x ARM:
# no aplica a este SoC y dejaba el gate de build-kernel.sh en FAIL)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_MT7621_WDT=y
# el WDT que deja activo RouterBOOT lo administra el kernel; el userspace no
# debe alimentarlo (ver KERNELDESDE0/ERRORES-RED-E2.md, ERROR 2)
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
