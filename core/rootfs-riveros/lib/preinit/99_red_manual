#!/bin/sh
red_manual() {
	local iface n=0
	while [ "$n" -lt 90 ]; do
		[ -d /sys/class/net/wan ] &&
		[ -d /sys/class/net/lan2 ] &&
		[ -d /sys/class/net/lan3 ] &&
		[ -d /sys/class/net/lan4 ] &&
		[ -d /sys/class/net/lan5 ] && break
		sleep 1
		n=$((n + 1))
	done

	[ -d /sys/class/net/wan ] || return 0
	# orden documentado DSA (docs.kernel.org dsa/configuration + duck.ai):
	# el master/conduit (eth0/sw0) DEBE estar UP antes que los puertos DSA
	ifconfig lo up 2>/dev/null
	if [ -d /sys/class/net/eth0 ]; then
		ifconfig eth0 up 2>/dev/null
		echo "[preinit] eth0 (conduit) up" >>/tmp/init.log 2>/dev/null
	fi
	if [ -d /sys/class/net/sw0 ]; then
		ifconfig sw0 up 2>/dev/null
		echo "[preinit] sw0 (conduit) up" >>/tmp/init.log 2>/dev/null
	fi
	ifconfig wan up 2>/dev/null
	for iface in lan2 lan3 lan4 lan5; do
		[ -d "/sys/class/net/$iface" ] &&
			ifconfig "$iface" up 2>/dev/null
	done
	echo "[preinit] provisional DSA interfaces ready" >>/tmp/init.log 2>/dev/null
	echo "[preinit] provisional DSA interfaces ready" >/dev/kmsg 2>/dev/null
}

boot_hook_add initramfs red_manual
