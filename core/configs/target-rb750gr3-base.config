# RiverOs target config — PERFIL BASE PURA (plantilla maestra)
# Solo lo necesario para: kernel netboot + preinit + dropbear SSH + red IPv4.
# Fuera de base (se agregan al derivar): dnsmasq, firewall4, nftables, ppp,
# odhcp*, kmod-usb3, kmod-crypto-hw-eip93, uclient/urandom extras.
# Nota: el initramfs netboot YA usa solo este conjunto; este archivo fija el
# contrato para el arbol/Makefile propio (camino 2).

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mikrotik_routerboard-750gr3=y

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_busybox=y
CONFIG_DEFAULT_dropbear=y
CONFIG_DEFAULT_fstools=y
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_DEFAULT_mtd=y
CONFIG_DEFAULT_netifd=y
CONFIG_DEFAULT_procd=y
CONFIG_DEFAULT_uci=y
CONFIG_DEFAULT_ubox=y
CONFIG_DEFAULT_ubus=y
CONFIG_DEFAULT_ubusd=y
CONFIG_DEFAULT_urandom-seed=y
CONFIG_DEFAULT_urngd=y
