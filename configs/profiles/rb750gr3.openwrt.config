# RiverOs .config de TARGET OpenWrt (para el arbol completo, v25.12.0)
# Copiar a <openwrt>/.config y ejecutar: make defconfig
# Simbolos segun Duck.ai (v25.12.0) — confirmar con:
#   grep -n -C15 "rb750gr3" target/linux/ramips/image/mt7621.mk
#
# Target / device
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_mikrotik_rb750gr3=y

# Initramfs para netboot
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- Paquetes activos (perfil netest, 52 paq) ---
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_kmod-usb3=y
# libc/libgcc: dependencias base, las activa make defconfig

# --- Paquetes desactivados (por defecto en OpenWrt) ---
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_ca-bundle is not set
# CONFIG_PACKAGE_uclient-fetch is not set
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_procd-ujail is not set
# CONFIG_PACKAGE_procd-seccomp is not set
# CONFIG_PACKAGE_kmod-mt7615-firmware is not set
# CONFIG_PACKAGE_kmod-crypto-hw-eip93 is not set
# CONFIG_PACKAGE_uboot-envtools is not set
